local IgnoredMobs = {}
local AutoLearnedDamage = 0

local function detectPlayerDamageFromGui()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if not gui then return 0 end
    
    local bestFound = 0
    local function searchLabels(parent)
        for _, obj in ipairs(parent:GetChildren()) do
            if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                local text = obj.Text or ""
                local name = obj.Name:lower()
                if name:find("dmg") or name:find("damage") or name:find("power") or name:find("strength") or text:find("⚔") or text:lower():find("dmg") then
                    local parsed = parseSuffixedNumber(text)
                    if parsed > bestFound then bestFound = parsed end
                end
            end
            if #obj:GetChildren() > 0 then
                searchLabels(obj)
            end
        end
    end
    
    pcall(function() searchLabels(gui) end)
    return bestFound
end

local function getEffectivePlayerDamage()
    if Config.UserDamageNum and Config.UserDamageNum > 0 then
        return Config.UserDamageNum
    end
    if AutoLearnedDamage > 0 then
        return AutoLearnedDamage
    end
    local guiDmg = detectPlayerDamageFromGui()
    if guiDmg > 0 then
        AutoLearnedDamage = guiDmg
        return guiDmg
    end
    return 0
end

