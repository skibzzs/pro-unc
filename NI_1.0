-- ================= NUMBER / SUFFIX PARSER =================
local SuffixMultipliers = {
    ["k"]   = 1e3,
    ["m"]   = 1e6,
    ["b"]   = 1e9,
    ["t"]   = 1e12,
    ["qa"]  = 1e15, ["qd"] = 1e15, ["quad"] = 1e15,
    ["qn"]  = 1e18, ["qi"] = 1e18, ["quin"] = 1e18,
    ["sx"]  = 1e21, ["sex"] = 1e21,
    ["sp"]  = 1e24, ["sept"] = 1e24,
    ["oc"]  = 1e27, ["oct"] = 1e27,
    ["no"]  = 1e30, ["non"] = 1e30,
    ["dc"]  = 1e33, ["dec"] = 1e33,
    ["ud"]  = 1e36, ["ude"] = 1e36, ["undec"] = 1e36,
    ["dd"]  = 1e39, ["duodec"] = 1e39,
    ["td"]  = 1e42, ["tredec"] = 1e42,
    ["qad"] = 1e45, ["quattuordec"] = 1e45,
    ["qnd"] = 1e48, ["quindec"] = 1e48,
    ["sxd"] = 1e51, ["sexdec"] = 1e51,
    ["spd"] = 1e54, ["septendec"] = 1e54,
    ["ocd"] = 1e57, ["octodec"] = 1e57,
    ["nod"] = 1e60, ["novemdec"] = 1e60,
    ["vg"]  = 1e63, ["vig"] = 1e63,
    ["uvg"] = 1e66,
    ["dvg"] = 1e69,
    ["tvg"] = 1e72
}

local function parseSuffixedNumber(str)
    if not str or str == "" then return 0 end
    str = tostring(str):gsub("%s+", ""):gsub(",", "")
    
    local sciNum = tonumber(str)
    if sciNum then return sciNum end
    
    local numPart, sufPart = str:match("^([%d%.]+)(%a+)$")
    if numPart and sufPart then
        local n = tonumber(numPart)
        local s = sufPart:lower()
        if n and SuffixMultipliers[s] then
            return n * SuffixMultipliers[s]
        end
    end
    
    local pureNum = str:match("[%d%.]+")
    return tonumber(pureNum) or 0
end

