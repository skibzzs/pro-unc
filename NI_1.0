local function getGameContent()
    return workspace:FindFirstChild("__GAME_CONTENT")
end

local function getTrialsFolder()
    local content = getGameContent()
    if not content then return nil end
    
    if content:FindFirstChild("Trials") then
        return content.Trials
    end
    
    local contents = content:FindFirstChild("Contents")
    if contents then
        for _, world in ipairs(contents:GetChildren()) do
            local trials = world:FindFirstChild("Trials")
            if trials then return trials end
        end
    end
    
    return content:FindFirstChild("Trials", true)
end

local function scanRealm3Mobs()
    local content = getGameContent()
    local mobsFolder = nil
    
    if content then
        mobsFolder = content:FindFirstChild("Mobs")
        if not mobsFolder and content:FindFirstChild("Contents") then
            local w3 = content.Contents:FindFirstChild("WORLD - 3") or content.Contents:FindFirstChildWhichIsA("Folder")
            if w3 then mobsFolder = w3:FindFirstChild("Mobs") end
        end
    end
    
    local sorted = {}
    if mobsFolder then
        local unique = {}
        for _, mob in pairs(mobsFolder:GetChildren()) do
            if mob:IsA("Model") and not unique[mob.Name] then unique[mob.Name] = true end
        end
        for k, _ in pairs(unique) do table.insert(sorted, k) end
        table.sort(sorted)
    end
    if #sorted == 0 then table.insert(sorted, "None") end
    Realm3Dropdown:Refresh(sorted, true)
    return #sorted > 0 and (sorted[1] ~= "None" and #sorted or 0) or 0
end

RealmTab:CreateButton({
    Name = "Refresh Mob List",
    Callback = function()
        local count = scanRealm3Mobs()
        Rayfield:Notify({Title = "Mobs Refreshed", Content = "Found " .. tostring(count) .. " unique mob types.", Duration = 3})
    end,
})

scanRealm3Mobs()

