local function buildReturnOptions()
    local opts = {"Auto (Pre-Trial)"}
    for k, _ in pairs(CustomPositions) do table.insert(opts, k) end
    table.sort(opts, function(a, b)
        if a == "Auto (Pre-Trial)" then return true end
        if b == "Auto (Pre-Trial)" then return false end
        return a < b
    end)
    return opts
end

