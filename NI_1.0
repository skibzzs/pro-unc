local configFile = "AxiomConfigs/TrialAutoSave.json"

local Config = {
    AutoTrial = false,
    TrialDifficulty = "Hard",
    ReturnPos = true,
    ReturnLocation = "Auto (Pre-Trial)",
    LeaveEarlyMins = 0,
    AutoFarmRealm3 = false,
    Realm3TargetMobs = {"None"},
    AutoPrivateServer = false,
    AutoTeleportLoop = false,
    UserDamageStr = "0",
    UserDamageNum = 0
}

-- Load saved JSON settings immediately before building UI elements
if isfile and isfile(configFile) then
    pcall(function()
        local decoded = HttpService:JSONDecode(readfile(configFile))
        if type(decoded) == "table" then
            if decoded.AutoTrial ~= nil then Config.AutoTrial = decoded.AutoTrial end
            if decoded.AutoTeleportLoop ~= nil then Config.AutoTeleportLoop = decoded.AutoTeleportLoop end
            if decoded.TrialDifficulty ~= nil then Config.TrialDifficulty = decoded.TrialDifficulty end
            if decoded.UserDamageStr ~= nil then
                Config.UserDamageStr = tostring(decoded.UserDamageStr)
                Config.UserDamageNum = parseSuffixedNumber(decoded.UserDamageStr)
            end
            if decoded.LeaveEarlyMins ~= nil then Config.LeaveEarlyMins = decoded.LeaveEarlyMins end
            if decoded.ReturnPos ~= nil then Config.ReturnPos = decoded.ReturnPos end
            if decoded.ReturnLocation ~= nil then Config.ReturnLocation = decoded.ReturnLocation end
            if decoded.AutoFarmRealm3 ~= nil then Config.AutoFarmRealm3 = decoded.AutoFarmRealm3 end
            if decoded.Realm3TargetMobs ~= nil then Config.Realm3TargetMobs = decoded.Realm3TargetMobs end
            if decoded.AutoPrivateServer ~= nil then Config.AutoPrivateServer = decoded.AutoPrivateServer end
        end
    end)
end

local function saveCustomConfig()
    if not writefile then return end
    local data = {
        AutoTrial = Config.AutoTrial,
        AutoTeleportLoop = Config.AutoTeleportLoop,
        TrialDifficulty = Config.TrialDifficulty,
        UserDamageStr = Config.UserDamageStr,
        LeaveEarlyMins = Config.LeaveEarlyMins,
        ReturnPos = Config.ReturnPos,
        ReturnLocation = Config.ReturnLocation,
        AutoFarmRealm3 = Config.AutoFarmRealm3,
        Realm3TargetMobs = Config.Realm3TargetMobs,
        AutoPrivateServer = Config.AutoPrivateServer
    }
    pcall(function()
        writefile(configFile, HttpService:JSONEncode(data))
    end)
end

-- ================= CUSTOM POSITIONS FILE =================
local CustomPositions = {}
local posFile = "AxiomConfigs/TrialPositions.json"

local function savePositions()
    if not writefile then return end
    local toSave = {}
    for k, v in pairs(CustomPositions) do
        toSave[k] = {X = v.X, Y = v.Y, Z = v.Z}
    end
    pcall(function() writefile(posFile, HttpService:JSONEncode(toSave)) end)
end

if isfile and isfile(posFile) then
    pcall(function()
        local decoded = HttpService:JSONDecode(readfile(posFile))
        for k, v in pairs(decoded) do
            CustomPositions[k] = Vector3.new(v.X, v.Y, v.Z)
        end
    end)
end

