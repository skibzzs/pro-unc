    end,
})

local function joinPrivateServer()
    local targetBtn = game:GetService("Players").LocalPlayer.PlayerGui.Settings.Main.Frame.Settings.ScrollingFrame["Join Private Server"].Button

    local function trigger_button()
        local success = false

        local connections = getconnections(targetBtn.MouseButton1Click)
        if #connections > 0 then
            for _, conn in ipairs(connections) do
                pcall(function() conn:Fire() end)
                pcall(function() conn.Function() end)
            end
            success = true
        end

        if not success then
            connections = getconnections(targetBtn.Activated)
            if #connections > 0 then
                for _, conn in ipairs(connections) do
                    pcall(function() conn:Fire() end)
                    pcall(function() conn.Function() end)
                end
                success = true
            end
        end

        return success
    end

    local ran, triggered = pcall(trigger_button)

    if not ran or not triggered then
        local absPos = targetBtn.AbsolutePosition
        local absSize = targetBtn.AbsoluteSize

        local targetX = absPos.X + (absSize.X / 2)
        local targetY = absPos.Y + (absSize.Y / 2) + 36

        local vu = game:GetService("VirtualUser")
        vu:Button1Down(Vector2.new(targetX, targetY))
        task.wait(0.05)
        vu:Button1Up(Vector2.new(targetX, targetY))
    end
end

PrivateServerTab:CreateButton({
    Name = "Test Private Server Join",
    Callback = function()
        local ok, err = pcall(joinPrivateServer)
        if not ok then
            Rayfield:Notify({Title = "Private Server FAILED", Content = tostring(err), Duration = 5})
        else
            Rayfield:Notify({Title = "Private Server", Content = "Join button triggered", Duration = 3})
        end
    end,
})

local PrivateServerTriggered = false

task.spawn(function()
    while task.wait(2) and getgenv().AxiomTrialRunning do
        local ok, err = pcall(function()
            if not Config.AutoPrivateServer then
                PrivateServerTriggered = false
                return
            end

            local totalPlayers = #Players:GetPlayers()

            if totalPlayers > 1 and not PrivateServerTriggered then
                PrivateServerTriggered = true
                Rayfield:Notify({Title = "Private Server", Content = "Other players detected (" .. tostring(totalPlayers) .. " total), joining private server...", Duration = 4})
                joinPrivateServer()
            elseif totalPlayers <= 1 then
                PrivateServerTriggered = false
            end
        end)

        if not ok then
            warn("AxiomPrivateServerWatcherError:", err)
        end
    end
end)

-- ================= CORE HELPERS =================
local function getEnemyPos(mob)
    local ok, result = pcall(function()
        local hrp = mob:FindFirstChild("HumanoidRootPart", true)
        if hrp then return hrp.Position end
        return mob:GetPivot().Position
    end)
    if ok then return result end
    return nil
end

local function getEnemyHp(mob)
    local ok, result = pcall(function()
        local oresUI = mob:FindFirstChild("OresTopUI", true)
        if oresUI then
            local healthNode = oresUI:FindFirstChild("Health", true)
            if healthNode then
                local valStr = ""
                pcall(function() valStr = tostring(healthNode.Text) end)
                if valStr == "" or valStr == "nil" then
                    pcall(function() valStr = tostring(healthNode.Value) end)
                end
                if string.find(string.lower(valStr), "respawn") then return -999 end
                return parseSuffixedNumber(valStr)
            end
        end
        local hum = mob:FindFirstChildOfClass("Humanoid") or mob:FindFirstChild("Humanoid", true)
        if hum then return hum.Health end
        return 100
    end)
    if ok and result ~= nil then return result end
    return -999
end

local function isEnemyDead(mob)
    local ok, result = pcall(function()
        if not mob or not mob.Parent then return true end
        if IgnoredMobs[mob] and os.time() < IgnoredMobs[mob] then return true end
        local hp = getEnemyHp(mob)
        if hp == -999 or hp <= 0 then return true end
        local head = mob:FindFirstChild("Head") or mob:FindFirstChild("UpperTorso") or mob:FindFirstChild("Torso")
        if head and head:IsA("BasePart") and head.Transparency >= 1 then return true end
        return false
    end)
    if ok then return result end
    return true
end

local function isOneShot(mob)
    local effDmg = getEffectivePlayerDamage()
    if effDmg and effDmg > 0 then
        local hp = getEnemyHp(mob)
        if hp > 0 and effDmg >= hp then
            return true
        end
    end
    return false
end

local function getAliveEnemies()
    local trials = getTrialsFolder()
    if not trials then return {} end
    
    local diffRoomName = Config.TrialDifficulty .. "TrialRoom"
    local room = trials:FindFirstChild(diffRoomName)
    local mobsFolder = room and room:FindFirstChild("Mobs")
    if not mobsFolder then return {} end
    
    local alive = {}
    for _, mob in pairs(mobsFolder:GetChildren()) do
        if mob:IsA("Model") and not isEnemyDead(mob) then table.insert(alive, mob) end
    end
    return alive
end

local function getOptimalSweepPath(enemies)
    local root = getRoot()
    if not root then return {} end
    
    local pool = {}
    for _, m in ipairs(enemies) do
        local p = getEnemyPos(m)
        if p and not isEnemyDead(m) then
            table.insert(pool, {mob = m, pos = p})
        end
    end
    
    local ordered = {}
    local currPos = root.Position
    
    while #pool > 0 do
        local bestIdx, bestDist = 1, math.huge
        for i, item in ipairs(pool) do
            local d = (currPos - item.pos).Magnitude
            if d < bestDist then
                bestDist = d
                bestIdx = i
            end
        end
        
        local chosen = table.remove(pool, bestIdx)
        table.insert(ordered, chosen.mob)
        currPos = chosen.pos
    end
    
    return ordered
end

local function getClosestRealm3Mob()
    local targets = Config.Realm3TargetMobs
    if type(targets) ~= "table" then targets = {targets} end
    if not targets or #targets == 0 then return nil end
    local validTargets = {}
    for _, v in pairs(targets) do if v ~= "None" then validTargets[v] = true end end
    
    local content = getGameContent()
    if not content then return nil end
    local mobsFolder = content:FindFirstChild("Mobs")
    if not mobsFolder and content:FindFirstChild("Contents") then
        local w3 = content.Contents:FindFirstChild("WORLD - 3") or content.Contents:FindFirstChildWhichIsA("Folder")
        if w3 then mobsFolder = w3:FindFirstChild("Mobs") end
    end
    if not mobsFolder then return nil end
    
    local closest, dist = nil, math.huge
    local root = getRoot()
    if not root then return nil end
    for _, mob in pairs(mobsFolder:GetChildren()) do
        if mob:IsA("Model") and validTargets[mob.Name] and not isEnemyDead(mob) then
            local pos = getEnemyPos(mob)
            if pos then
                local d = (root.Position - pos).Magnitude
                if d < dist then closest, dist = mob, d end
            end
        end
    end
    return closest
end

local function teleportToStatic(targetPos)
    local root = getRoot()
    if not root then return end
    root.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
    task.wait(0.2)
end

-- ================= TELEPORT SEQUENCE LOOP =================
task.spawn(function()
    while getgenv().AxiomTrialRunning do
        if Config.AutoTeleportLoop then
            -- Step 1: Teleport to 556, 6, 7818
            teleportToStatic(Vector3.new(556, 6, 7818))

            -- Step 2: Wait 4 seconds
            task.wait(4)
            if not getgenv().AxiomTrialRunning or not Config.AutoTeleportLoop then continue end

            -- Step 3: Teleport to 548, 3, 7827
            teleportToStatic(Vector3.new(548, 3, 7827))

            -- Step 4: Wait 90 seconds
            task.wait(90)
            if not getgenv().AxiomTrialRunning or not Config.AutoTeleportLoop then continue end

            -- Step 5: Teleport to 560, 5, 7825
            teleportToStatic(Vector3.new(560, 5, 7825))

            task.wait(1)
        else
            task.wait(0.5)
        end
    end
end)

-- ================= LEAVE TRIAL BUTTON HANDLING =================
local function findLeaveTrialButton()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    local hud = gui and gui:FindFirstChild("HUD")
    if not hud then return nil end
    return hud:FindFirstChild("LeaveTrial", true)
end

local function triggerLeaveButton()
    local leaveBtn = findLeaveTrialButton()
    if not leaveBtn then return false end

    local fired = false
    pcall(function()
        if leaveBtn.Activate then
            leaveBtn:Activate()
            fired = true
        end
    end)

    pcall(function()
        if firesignal then
            if leaveBtn.MouseButton1Click then firesignal(leaveBtn.MouseButton1Click) fired = true end
            if leaveBtn.MouseButton1Down then firesignal(leaveBtn.MouseButton1Down) fired = true end
            if leaveBtn.Activated then firesignal(leaveBtn.Activated) fired = true end
        elseif getconnections then
            for _, eventName in ipairs({"MouseButton1Click", "MouseButton1Down", "Activated"}) do
                local sig = leaveBtn[eventName]
                if sig then
                    for _, conn in ipairs(getconnections(sig)) do
                        pcall(function() conn:Function() end)
                        fired = true
                    end
                end
            end
        end
    end)
    return fired
end

local function requestTrialLeave(reason)
    if LeaveRequested then return end
    LeaveRequested = true
    LeaveReason = reason or "Unknown"
    LastLeaveAttempt = 0
end

-- ================= ENTER / EXIT TRIAL =================
local function enterTrial()
    local trials = getTrialsFolder()
    if not trials then return end
    
    local diffRoomName = Config.TrialDifficulty .. "TrialRoom"
    local padName = "__Trial" .. Config.TrialDifficulty .. "Room"
    local room = trials:FindFirstChild(diffRoomName)
    if not room then return end
    
    local diffPad = room:FindFirstChild(padName) or room:FindFirstChildWhichIsA("Model") or room:FindFirstChildWhichIsA("BasePart")
    if not diffPad then return end
    
    teleportToStatic(diffPad:GetPivot().Position)
end

local function delayedReturnTeleport(skipReturn)
    if skipReturn then
        SavedPos = nil
        return
    end
    if not Config.ReturnPos then
        SavedPos = nil
        return
    end

    task.spawn(function()
        local waitTime = math.random(20, 30)
        task.wait(waitTime)

        local targetReturn = nil
        if Config.ReturnLocation == "Auto (Pre-Trial)" then
            targetReturn = SavedPos
        elseif CustomPositions[Config.ReturnLocation] then
            targetReturn = CustomPositions[Config.ReturnLocation]
        end

        if targetReturn then
            teleportToStatic(targetReturn)
        end
        SavedPos = nil
    end)
end

local function finalizeTrialLeave()
    LeaveRequested = false
    LeaveReason = nil
    IsTrialing = false
    ForceTrial = false
    CurrentWave = 0
    RoomEmpty = true
    HitEnemies = {}

    delayedReturnTeleport(false)
end

-- ================= COMBAT MOVEMENT =================
local function walkToEnemy(enemy)
    local root, hum = getRoot(), getHum()
    if not root or not hum then return end

    local moveStuckTimer = 0
    local hpStuckTimer = 0
    local initialHp = getEnemyHp(enemy)
    local lastHp = initialHp
    local lastMyPos = root.Position
    local startAttackTime = os.clock()
    local wasOneShot = isOneShot(enemy)

    while enemy and not isEnemyDead(enemy) and root and hum and (Config.AutoTrial or Config.AutoFarmRealm3 or ForceTrial) and getgenv().AxiomTrialRunning do
        local ePos = getEnemyPos(enemy)
        if not ePos then
            IgnoredMobs[enemy] = os.time() + 10
            break
        end
        
        local dist = (root.Position - ePos).Magnitude
        hum:MoveTo(ePos)

        if wasOneShot and dist <= 7 then
            task.wait(0.04)
            if isEnemyDead(enemy) then
                break
            end
        end

        local myMovementDist = (root.Position - lastMyPos).Magnitude
        lastMyPos = root.Position

        if myMovementDist < 0.5 and dist > 5 then
            moveStuckTimer = moveStuckTimer + 0.05
            if moveStuckTimer > 1.8 then
                hum.Jump = true
                if moveStuckTimer > 2.5 then
                    IgnoredMobs[enemy] = os.time() + 10
                    break
                end
            end
        else
            moveStuckTimer = 0
        end

        if dist < 25 then
            local currentHp = getEnemyHp(enemy)
            if currentHp == -999 then break end
            
            if initialHp > 0 and currentHp < lastHp then
                local delta = lastHp - currentHp
                if delta > AutoLearnedDamage then
                    AutoLearnedDamage = delta
                end
            end

            if currentHp == lastHp then
                hpStuckTimer = hpStuckTimer + 0.05
                if hpStuckTimer > 2.5 then
                    IgnoredMobs[enemy] = os.time() + 10
                    break
                end
            else
                lastHp = currentHp
                hpStuckTimer = 0
            end
        else
            hpStuckTimer = 0
            lastHp = getEnemyHp(enemy)
        end

        task.wait(0.03)
    end

    if initialHp > 0 and (os.clock() - startAttackTime) <= 0.25 and initialHp > AutoLearnedDamage then
        AutoLearnedDamage = initialHp
    end
end

local function safeWalkToEnemy(enemy)
    local ok, err = pcall(function()
        walkToEnemy(enemy)
    end)
    if not ok then
        warn("AxiomError on mob, blacklisting:", err)
        pcall(function() IgnoredMobs[enemy] = os.time() + 10 end)
    end
end

-- ================= MAIN LOOP =================
task.spawn(function()
    while task.wait(0.1) and getgenv().AxiomTrialRunning do
        local ok, err = pcall(function()
            local isTrialActive = Config.AutoTrial or ForceTrial
            local isRealmActive = Config.AutoFarmRealm3

            if not isTrialActive and not isRealmActive then
                if IsTrialing then
                    requestTrialLeave("Disabled")
                end
            end

            local aliveEnemies = getAliveEnemies()

            if #aliveEnemies == 0 then
                RoomEmpty = true
            elseif RoomEmpty then
                CurrentWave = CurrentWave + 1
                RoomEmpty = false
                HitEnemies = {}
            end

            local m = os.date("*t").min
            local triggerTime = (m == 29 or m == 59)
            local inWindow = (m >= 29 and m <= 49) or (m >= 59 or m <= 19)

            if isTrialActive then
                if #aliveEnemies > 0 and not IsTrialing then
                    IsTrialing = true
                    TrialStartTime = os.time()
                    CurrentWave = 1
                    RoomEmpty = false
                    HitEnemies = {}
                elseif (triggerTime or ForceTrial) and not IsTrialing then
                    IsTrialing = true
                    if ForceTrial then
                        TrialStartTime = os.time()
                    else
                        TrialStartTime = os.time() + 60
                    end
                    CurrentWave = 0
                    RoomEmpty = true
                    HitEnemies = {}
                    if Config.ReturnPos and Config.ReturnLocation == "Auto (Pre-Trial)" and getRoot() then
                        SavedPos = getRoot().Position
                    end
                    enterTrial()
                elseif IsTrialing then
                    local elapsedSeconds = math.max(0, os.time() - TrialStartTime)
                    local elapsedMins = elapsedSeconds / 60

                    if Config.LeaveEarlyMins > 0 and elapsedMins >= Config.LeaveEarlyMins then
                        requestTrialLeave("LeaveEarly")
                    end

                    if LeaveRequested then
                        if os.clock() - LastLeaveAttempt >= 1 then
                            LastLeaveAttempt = os.clock()
                            triggerLeaveButton()
                        end

                        local leaveBtn = findLeaveTrialButton()
                        if not leaveBtn or leaveBtn.Visible == false then
                            finalizeTrialLeave()
                        end

                        return
                    end

                    if #aliveEnemies > 0 then
                        local sweepPath = getOptimalSweepPath(aliveEnemies)
                        for _, mob in ipairs(sweepPath) do
                            if not isEnemyDead(mob) and (Config.AutoTrial or ForceTrial) and not LeaveRequested then
                                safeWalkToEnemy(mob)
                            end
                        end
                    else
                        if not inWindow and not ForceTrial then
                            requestTrialLeave("WindowEnded")
                        end
                    end
                end
            end

            if not IsTrialing and isRealmActive then
                local enemy = getClosestRealm3Mob()
                if enemy then safeWalkToEnemy(enemy) end
            end
        end)

        if not ok then
            warn("AxiomLoopError:", err)
        end
    end
end)
